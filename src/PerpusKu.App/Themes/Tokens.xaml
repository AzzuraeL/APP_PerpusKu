<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: Passport Travel UI - typewriter Courier Prime, base radius 8px, soft card shadow -->
    <!-- Courier Prime di-embed (Fonts/*.ttf, SIL Open Font License) agar konsisten di semua mesin -->
    <FontFamily x:Key="HeadFont">pack://application:,,,/PerpusKu;component/Fonts/#Courier Prime, Courier New</FontFamily>
    <FontFamily x:Key="BodyFont">pack://application:,,,/PerpusKu;component/Fonts/#Courier Prime, Courier New</FontFamily>

    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>

    <DropShadowEffect x:Key="CardShadow" x:Shared="False" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.06" Color="#000000"/>
</ResourceDictionary>
