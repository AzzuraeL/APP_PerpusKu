<UserControl x:Class="PerpusKu.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Center">
    <Border Style="{StaticResource Pill}" Background="{Binding Status, ElementName=Root, Converter={StaticResource StatusSoft}}">
        <TextBlock Text="{Binding Text, ElementName=Root}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{Binding Status, ElementName=Root, Converter={StaticResource StatusFg}}"/>
    </Border>
</UserControl>
