<UserControl x:Class="PerpusKu.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="8" Background="{Binding SoftBrush, ElementName=Root}" VerticalAlignment="Top">
                <Path Data="{Binding Glyph, ElementName=Root, Converter={StaticResource IconGeom}}" Style="{StaticResource IconPath}" Width="22" Height="22"
                           Stroke="{Binding AccentBrush, ElementName=Root}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="{Binding Value, ElementName=Root}" Style="{StaticResource H1}" FontSize="30" LineHeight="34"/>
                <TextBlock Text="{Binding Label, ElementName=Root}" FontWeight="SemiBold" FontSize="13.5"/>
                <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
