<UserControl x:Class="PerpusKu.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <TextBox x:Name="Input" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Padding="40,9,12,9" Height="40"/>
        <Path Data="{StaticResource Icon.search}" Style="{StaticResource IconPath}" Width="14" Height="14" Margin="14,0,0,0"
                   Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Placeholder, ElementName=Root}" Margin="40,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
