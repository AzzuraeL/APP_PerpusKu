<Window x:Class="PerpusKu.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerpusKu" Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Icon rail (bisa diperluas) ===== -->
        <Border Background="{DynamicResource RailBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="76"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RailExpanded}" Value="True">
                            <Setter Property="Width" Value="248"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <!-- Merek -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,0,22">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource RailAccentBrush}">
                        <Path Data="{StaticResource Icon.library}" Style="{StaticResource IconPath}" Width="20" Height="20"
                              Stroke="{DynamicResource RailAccentTextBrush}"/>
                    </Border>
                    <TextBlock Text="PerpusKu" FontFamily="{StaticResource HeadFont}" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding RailExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Pengguna + keluar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,16">
                    <Button Command="{Binding LogoutCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                            ToolTip="Keluar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Padding="8" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource RailAccentBrush}">
                                            <TextBlock Text="{Binding User.Inisial}" FontWeight="Bold" Foreground="{DynamicResource RailAccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="120"
                                                    Visibility="{Binding DataContext.RailExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding User.NamaLengkap}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding User.Role, Converter={StaticResource RoleText}}" Foreground="{DynamicResource RailTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Path Data="{StaticResource Icon.log-out}" Style="{StaticResource IconPath}" Width="15" Height="15" Stroke="{DynamicResource RailTextBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                   Visibility="{Binding DataContext.RailExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RailActiveBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Navigasi -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===== Area konten ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Command bar -->
            <Grid Margin="28,22,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRailCommand}"
                        VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Ciutkan / perluas menu">
                    <Path Data="{StaticResource Icon.panel-left}" Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="{DynamicResource TextBrush}"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" FontSize="26"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Today}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Ganti tema terang / gelap"
                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <Path Data="{Binding ThemeGlyph, Converter={StaticResource IconGeom}}" Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="{DynamicResource TextBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Halaman aktif -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28,6,28,24" IsTabStop="False"/>
        </Grid>

        <!-- ===== Toast ===== -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,28,28" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{Binding AccentKey, Converter={StaticResource KeyBrush}}"
                            BorderThickness="1.5" CornerRadius="8" Padding="14,11" Margin="0,8,0,0" MaxWidth="420">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{Binding Glyph, Converter={StaticResource IconGeom}}" Style="{StaticResource IconPath}" Width="17" Height="17"
                                       Stroke="{Binding AccentKey, Converter={StaticResource KeyBrush}}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="340"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
