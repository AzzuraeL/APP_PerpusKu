<Window x:Class="PerpusKu.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>
        <Grid MinWidth="460">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="26,20,16,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Click="Close_Click" ToolTip="Tutup">
                        <Path Data="{StaticResource Icon.x}" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>
            <ContentPresenter Grid.Row="1" Content="{Binding}"/>
        </Grid>
    </Border>
</Window>
