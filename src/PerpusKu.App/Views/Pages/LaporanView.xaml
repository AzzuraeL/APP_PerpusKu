<UserControl x:Class="PerpusKu.Views.Pages.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PerpusKu.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter periode -->
        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Dari tanggal" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Dari}" Width="170"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Sampai tanggal" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Sampai}" Width="170"/>
                    </StackPanel>
                    <Button Content="Terapkan" Command="{Binding TerapkanCommand}" VerticalAlignment="Bottom" Height="40" Margin="0,0,16,0"/>
                    <Button Content="7 hari" Command="{Binding PresetCommand}" CommandParameter="7" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="40"/>
                    <Button Content="30 hari" Command="{Binding PresetCommand}" CommandParameter="30" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="40"/>
                    <Button Content="Bulan ini" Command="{Binding PresetCommand}" CommandParameter="bulan" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="40"/>
                    <Button Content="Ekspor PDF" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="40" Margin="40,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="2,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Ringkasan -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <ctl:StatCard Label="Total peminjaman" Value="{Binding Ringkasan.TotalPinjam}" Caption="Pada periode terpilih" Glyph="clock"
                          AccentBrush="{DynamicResource PrimaryBrush}" SoftBrush="{DynamicResource PrimarySoftBrush}" Margin="0,0,9,0"/>
            <ctl:StatCard Label="Sudah kembali" Value="{Binding Ringkasan.Dikembalikan}" Caption="Transaksi selesai" Glyph="check"
                          AccentBrush="{DynamicResource SuccessBrush}" SoftBrush="{DynamicResource SuccessSoftBrush}" Margin="9,0,9,0"/>
            <ctl:StatCard Label="Masih dipinjam" Value="{Binding Ringkasan.MasihDipinjam}" Caption="Belum dikembalikan" Glyph="history"
                          AccentBrush="{DynamicResource AccentBrush}" SoftBrush="{DynamicResource AccentSoftBrush}" Margin="9,0,9,0"/>
            <ctl:StatCard Label="Total denda" Value="{Binding Ringkasan.TotalDenda, StringFormat='{}Rp {0:N0}'}" Caption="Dari keterlambatan" Glyph="triangle-alert"
                          AccentBrush="{DynamicResource DangerBrush}" SoftBrush="{DynamicResource DangerSoftBrush}" Margin="9,0,0,0"/>
        </UniformGrid>

        <!-- Detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Buku terpopuler" Style="{StaticResource H2}"/>
                        <TextBlock Text="Lima judul paling sering dipinjam" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Populer}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding Peringkat}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Penulis}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding JumlahPinjam, StringFormat='{}{0}×'}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Belum ada data pada periode ini." Style="{StaticResource Muted}"
                                   Visibility="{Binding PopulerKosong, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="6,18,6,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,14,10">
                        <TextBlock Text="Rincian transaksi" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding RowsInfo}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Rows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PINJAM" Binding="{Binding TanggalPinjam, StringFormat='{}{0:dd MMM}'}" Width="80"/>
                                <DataGridTextColumn Header="BUKU" Binding="{Binding Judul}" Width="*"/>
                                <DataGridTextColumn Header="ANGGOTA" Binding="{Binding NamaAnggota}" Width="150"/>
                                <DataGridTemplateColumn Header="STATUS" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ctl:StatusPill Status="{Binding Status}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="DENDA" Binding="{Binding DendaTampil, StringFormat='{}Rp {0:N0}'}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Tidak ada transaksi pada periode ini." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding RowsKosong, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
