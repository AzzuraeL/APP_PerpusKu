<UserControl x:Class="PerpusKu.Views.Pages.RiwayatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PerpusKu.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ctl:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="Cari judul, anggota, atau kode…"/>
            <ComboBox Grid.Column="1" Width="180" Margin="12,0,0,0" ItemsSource="{Binding StatusFilter}" SelectedItem="{Binding SelectedStatus}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <DataGrid ItemsSource="{Binding PageItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PINJAM" Binding="{Binding TanggalPinjam, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                        <DataGridTemplateColumn Header="BUKU" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding KodeBuku}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ANGGOTA" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding NamaAnggota}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NomorAnggota}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TEMPO" Binding="{Binding JatuhTempo, StringFormat='{}{0:dd MMM yyyy}'}" Width="120"/>
                        <DataGridTextColumn Header="KEMBALI" Binding="{Binding TanggalKembali, StringFormat='{}{0:dd MMM yyyy}', TargetNullValue='—'}" Width="120"/>
                        <DataGridTemplateColumn Header="STATUS" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ctl:StatusPill Status="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DENDA" Binding="{Binding DendaTampil, StringFormat='{}Rp {0:N0}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Belum ada transaksi yang cocok." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
        <ctl:PagerBar Grid.Row="2"/>
    </Grid>
</UserControl>
