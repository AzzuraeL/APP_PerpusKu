<UserControl x:Class="PerpusKu.Views.Pages.PengaturanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Tampilan -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Tampilan" Style="{StaticResource H2}"/>
                        <TextBlock Text="Pilih tema yang nyaman untuk mata Anda." Style="{StaticResource Muted}" Margin="0,2,0,14"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Tema" Content="☀  Terang"
                                             IsChecked="{Binding IsLight, Mode=OneWay}" Command="{Binding SetLightCommand}"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Tema" Content="☾  Gelap"
                                             IsChecked="{Binding IsDark, Mode=OneWay}" Command="{Binding SetDarkCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Akun -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Akun saya" Style="{StaticResource H2}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,18">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PrimarySoftBrush}">
                                <TextBlock Text="{Binding User.Inisial}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.NamaLengkap}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding User.Username, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding User.Role, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Ubah password" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Password lama" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="OldPw" PasswordChanged="OldPw_Changed"/>
                        <TextBlock Text="Password baru (min. 8 karakter, huruf + angka)" Style="{StaticResource FieldLabel}" Margin="2,12,0,6"/>
                        <PasswordBox x:Name="NewPw" PasswordChanged="NewPw_Changed"/>
                        <TextBlock Text="Ulangi password baru" Style="{StaticResource FieldLabel}" Margin="2,12,0,6"/>
                        <PasswordBox x:Name="ConfirmPw" PasswordChanged="ConfirmPw_Changed"/>
                        <TextBlock Text="{Binding PasswordError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding HasPasswordError, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Simpan password" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Aturan perpustakaan -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Aturan perpustakaan" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,14"
                               Text="Dipakai saat peminjaman, perpanjangan, dan perhitungan denda. Hanya Administrator yang dapat mengubah."/>
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Nilai, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding DataContext.CanEditRules, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RulesError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasRulesError, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Simpan aturan" Command="{Binding SaveRulesCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Visibility="{Binding CanEditRules, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
