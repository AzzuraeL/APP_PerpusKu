<UserControl x:Class="PerpusKu.Views.Pages.AnggotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PerpusKu.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ctl:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="Cari nama, nomor, atau email…"/>
            <ComboBox Grid.Column="1" Width="170" Margin="12,0,0,0" ItemsSource="{Binding TipeFilter}" SelectedItem="{Binding SelectedTipe}"/>
            <Button Grid.Column="3" Content="+  Daftarkan anggota" Style="{StaticResource PrimaryButton}" Height="40"
                    Command="{Binding TambahCommand}" Visibility="{Binding CanWrite, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <DataGrid ItemsSource="{Binding PageItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO. ANGGOTA" Binding="{Binding NomorAnggota}" Width="130"/>
                        <DataGridTemplateColumn Header="NAMA" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TIPE" Binding="{Binding Tipe}" Width="120"/>
                        <DataGridTextColumn Header="TELEPON" Binding="{Binding Telepon}" Width="150"/>
                        <DataGridTextColumn Header="TERDAFTAR" Binding="{Binding TanggalDaftar, StringFormat='{}{0:dd MMM yyyy}'}" Width="130"/>
                        <DataGridTemplateColumn Header="PINJAMAN" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SedangPinjam, StringFormat='{}{0} aktif'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="AKSI" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource PrimaryIconButton}" ToolTip="Ubah"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource Icon.pencil}" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerIconButton}" ToolTip="Hapus"
                                                Command="{Binding DataContext.HapusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource Icon.trash-2}" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Tidak ada anggota yang cocok." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
        <ctl:PagerBar Grid.Row="2"/>
    </Grid>
</UserControl>
