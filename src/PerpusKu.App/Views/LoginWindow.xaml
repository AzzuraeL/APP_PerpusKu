<Window x:Class="PerpusKu.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PerpusKu - Masuk" Width="940" Height="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Border Margin="14" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel kiri: rak buku dekoratif -->
            <Border CornerRadius="8,0,0,8" MouseLeftButtonDown="Drag" Background="{DynamicResource HeroBrush}">
                <Grid Margin="38">
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource PrimaryBrush}">
                                <Path Data="{StaticResource Icon.library}" Style="{StaticResource IconPath}" Width="22" Height="22"
                                      Stroke="{DynamicResource OnPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="PerpusKu" FontFamily="{StaticResource HeadFont}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource HeroTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Setiap buku punya cerita. Kelola semuanya dari satu meja."
                                   FontFamily="{StaticResource HeadFont}" FontSize="23" Foreground="{DynamicResource HeroTextBrush}" TextWrapping="Wrap"
                                   Margin="0,34,0,0" LineHeight="32"/>
                        <TextBlock Text="Katalog, anggota, peminjaman, dan denda dalam satu aplikasi."
                                   Foreground="{DynamicResource HeroMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                    <!-- rak buku -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                        <Border Width="26" Height="120" Background="#FF7F50" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="20" Height="150" Background="#F5F2E9" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="30" Height="105" Background="#B71C1C" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="22" Height="138" Background="#FFFFFF" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="28" Height="112" Background="#C5C9EC" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="18" Height="145" Background="#FF9470" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="32" Height="98" Background="#8F96E8" CornerRadius="4,4,0,0" Margin="0,0,5,0"/>
                        <Border Width="22" Height="128" Background="#F5F2E9" CornerRadius="4,4,0,0"/>
                    </StackPanel>
                    <Border Height="6" VerticalAlignment="Bottom" Margin="-12,0,-12,-8" Background="#0B0E2C" CornerRadius="3"/>
                </Grid>
            </Border>

            <!-- Panel kanan: form -->
            <Grid Grid.Column="1" Margin="54,40,54,36">
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-24,-36,0" Click="Close_Click" ToolTip="Tutup">
                    <Path Data="{StaticResource Icon.x}" Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Selamat datang" Style="{StaticResource H1}"/>
                    <TextBlock Text="Masuk untuk mengelola perpustakaan kampus." Style="{StaticResource Muted}" Margin="0,6,0,26"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="42"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             SelectionBrush="{DynamicResource PrimarySoftBrush}" SelectionTextBrush="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="2,16,0,6"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Height="42"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource PrimarySoftBrush}" SelectionTextBrush="{DynamicResource TextBrush}"/>

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,16,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <Button Content="Masuk" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Height="46" Margin="0,22,0,0" FontSize="15"/>

                    <StackPanel Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding DbFailed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5"/>
                            <Button Content="Coba lagi" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,22,0,0" FontSize="12">
                        <Run Text="Akun demo: "/><Run Text="admin / Admin#123" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
